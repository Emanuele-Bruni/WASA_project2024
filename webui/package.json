{
	"name": "wasatext",
	"version": "2.0.0",
	"scripts": {
		"dev": "vite",
		"build-dev": "vite build --mode development",
		"build-prod": "vite build --mode production",
		"preview": "vite preview --host 0.0.0.0 --port 4173",
		"test": "vitest run",
		"test:browser": "playwright test",
		"lint": "eslint . --max-warnings 0",
		"format": "prettier --write src e2e *.js *.json .prettierrc.json .yarnrc.yml index.html",
		"format:check": "prettier --check src e2e *.js *.json .prettierrc.json .yarnrc.yml index.html"
	},
	"dependencies": {
		"axios": "1.21.1",
		"vue": "3.5.45",
		"vue-router": "4.6.4"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.65.0",
		"@vitejs/plugin-vue": "6.0.10",
		"eslint": "10.14.0",
		"eslint-plugin-vue": "10.12.0",
		"globals": "17.14.0",
		"playwright-core": "1.65.0",
		"prettier": "3.9.10",
		"vite": "8.3.7",
		"vitest": "5.1.0",
		"vue-eslint-parser": "10.3.0"
	},
	"packageManager": "yarn@4.5.0",
	"type": "module",
	"engines": {
		"node": ">=22.13.0"
	}
}
