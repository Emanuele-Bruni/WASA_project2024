FROM node:24-bookworm-slim AS builder
WORKDIR /app
COPY webui/package.json webui/yarn.lock webui/.yarnrc.yml ./
COPY webui/.yarn/ ./.yarn/
RUN node .yarn/releases/yarn-4.5.0.cjs install --immutable --immutable-cache
COPY webui/ ./
RUN node .yarn/releases/yarn-4.5.0.cjs exec vite build --mode production

FROM nginx:stable-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/frontend/nginx.conf.template /etc/nginx/wasa.conf.template
COPY docker/frontend/start.sh /usr/local/bin/wasa-frontend
USER 101:101
ENV API_URL=/api BACKEND_URL=http://backend:3000
EXPOSE 8080
ENTRYPOINT ["/bin/sh", "/usr/local/bin/wasa-frontend"]
