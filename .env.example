# Optional: copy this file to .env. Docker Compose reads it automatically.
FRONTEND_PORT=8080
BACKEND_PORT=3000
# Browser API URL, evaluated when the frontend container starts.
# /api uses the same-origin nginx proxy (recommended for local Docker).
API_URL=/api
# Internal upstream for that proxy; this is not exposed to browser JavaScript.
BACKEND_URL=http://backend:3000
API_READ_TIMEOUT=5s
API_WRITE_TIMEOUT=5s
API_SHUTDOWN_TIMEOUT=5s
# Native Vite development/build only; Docker uses API_URL at runtime.
VITE_API_URL=http://localhost:3000
